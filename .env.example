SOT_BASE_URL=https://alamat-sot-internal/redmine/sot/issues
# Halaman SOT yang memuat daftar "Projects" (dipakai tombol Sinkron SOT).
SOT_PROJECTS_URL=https://alamat-sot-internal/redmine2/sot/projects

# Opsional, untuk pembacaan SOT lewat browser:
# SOT_HEADLESS=true      # true = Edge tanpa jendela. Pakai hanya jika login CompanyAccount sudah tersimpan di profil.
# SOT_BROWSER_PATH=      # jalur browser lain (bukan Microsoft Edge)
# SOT_PROFILE_DIR=       # profil Edge untuk SOT, default: data/edge_sot_profile

# Filter Team Leader untuk langkah "Saring Team Leader" (opsional).
# Kosong = fitur penyaringan tidak tersedia; daftar project tetap membaca semua project.
# Cara mencari ID: di SOT buka Issues, filter Team Leader, lalu lihat URL: ...v[cf_3][]=659  (659 = ID, cf_3 = nama field).
# SOT_TEAM_LEADER_ID=
# SOT_TEAM_LEADER_FIELD=cf_3
# SOT_ISSUE_STATUS=open       # open (default, ringan) atau all (semua status, bisa lambat)
# SOT_ISSUE_TIMEOUT_MS=120000 # batas tunggu per halaman issue, 10000-600000
# SOT_FY_FROM=                # opsional: lewati FY lama, mis. 24 = hanya FY24 ke atas

# Origin/IP yang boleh mengakses resource Next.js saat development dari komputer lain.
# Contoh: NEXT_ALLOWED_DEV_ORIGINS=172.16.231.52
# NEXT_ALLOWED_DEV_ORIGINS=
