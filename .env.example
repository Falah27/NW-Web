SOT_BASE_URL=https://alamat-sot-internal/redmine/sot/issues
SOT_PROJECTS_URL=https://alamat-sot-internal/redmine/projects
# Login SOT dilakukan otomatis dengan mengeklik "Login with CompanyAccount".
# Cookie sesi hanya diperlukan jika konfigurasi SOT tidak menyediakan login Company Account.
# SOT_COOKIE=
# Set false saat debugging agar jendela browser terlihat (default: true).
# SOT_BROWSER_HEADLESS=true
# Browser desktop yang dipakai untuk SSO (default: msedge).
# SOT_BROWSER_CHANNEL=msedge
# Direktori profile persistent untuk menyimpan sesi Microsoft SSO.
# SOT_BROWSER_PROFILE_DIR=.playwright/edge-sot-profile
